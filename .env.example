# SupportFlow Agent · 环境变量样例（Python 重构后）
#
# 复制为 .env 使用；所有变量都有默认值，本地演示时最小改动即可运行。
# 旧 Java 版的 MYSQL_* / MINIO_* / JWT 变量已随 docs/adr/0008 退役。

# --- 数据库（运行时唯一中间件，含 pgvector 扩展） -----------------------------
# compose 内部由服务名 postgres 解析；本机直跑时指向 localhost。
DATABASE_URL=postgresql+psycopg://supportflow:supportflow@localhost:5432/supportflow

# --- 模型接入 -----------------------------------------------------------------
# mock：确定性离线实现（默认）。real：OpenAI-compatible 网关，阶段 3 交付；
# 真实模式不可用时系统会明确报错，绝不静默降级为 mock。
MODEL_MODE=mock
# 加密模型 API Key 的主密钥（阶段 3 接入 real 模式时启用）。
MODEL_SECRET_MASTER_KEY=
# real 模式的请求超时与重试上限。
MODEL_REQUEST_TIMEOUT_SECONDS=30
MODEL_MAX_ATTEMPTS=3

# --- 会话与 Cookie ------------------------------------------------------------
SESSION_TTL_SECONDS=86400
# 生产/外网环境必须为 true（Cookie 仅经 HTTPS 传输）。
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Worker -------------------------------------------------------------------
WORKER_POLL_INTERVAL_SECONDS=1.0
WORKER_LEASE_OWNER=worker-local
RUN_LEASE_SECONDS=60

# --- SSE 事件流 ----------------------------------------------------------------
SSE_POLL_INTERVAL_SECONDS=0.5
SSE_MAX_DURATION_SECONDS=300

# --- 日志与端口 ----------------------------------------------------------------
LOG_LEVEL=INFO
API_PORT=8000
POSTGRES_PORT=5432

# --- 演示数据 ------------------------------------------------------------------
# 只用于本地演示账号（customer/agent/admin@example.com）；生产环境不应执行种子。
SEED_DEMO_PASSWORD=demo1234
