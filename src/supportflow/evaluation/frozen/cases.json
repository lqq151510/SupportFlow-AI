  "corpus": [
    {
      "title": "物流延误处理规范",
      "content": "物流长时间未更新时，先核实运单状态；确认异常后为客户补发，并告知新的时效。补发后需在工单中记录新的运单号。"
    },
    {
      "title": "退货政策",
      "content": "购买后 30 天内可申请退货，需保留原始包装与吊牌。退货审核通过后 3 个工作日内原路退款。"
    },
    {
      "title": "换货流程",
      "content": "质量问题可在签收后 15 天内申请换货，免运费；非质量问题换货运费由客户承担。"
    },
    {
      "title": "退款时效说明",
      "content": "退款审核通过后原路退回，一般 1-3 个工作日到账；节假日顺延。退款金额不含运费优惠券差额。"
    },
    {
      "title": "账号登录异常处理",
      "content": "账号无法登录时，先引导客户使用手机号验证码登录；仍失败则重置密码，必要时解绑旧设备。"
    },
    {
      "title": "修改收货地址",
      "content": "订单未发货前可自助修改收货地址；已发货订单无法修改，可联系承运商拦截后重新下发。"
    },
    {
      "title": "发票开具说明",
      "content": "电子发票在订单完成后 24 小时内开出，可在订单详情下载；抬头错误可在开票后 7 天内申请重开。"
    },
    {
      "title": "优惠券使用规则",
      "content": "每笔订单限用一张优惠券，优惠不与会员折扣叠加；退款时优惠券按实际支付比例退回。"
    },
    {
      "title": "产品固件升级指南",
      "content": "设备固件可在 App 内我的设备页面升级；升级前请保持电量 50% 以上，过程中请勿断电。"
    },
    {
      "title": "产品保修政策",
      "content": "整机保修一年，电池六个月；人为损坏不在保修范围。保修期内维修免费，需提供订单号。"
    },
    {
      "title": "投诉升级处理",
      "content": "客户明确表达投诉升级、要求赔偿或向监管部门反映时，必须转人工处理，不得自行承诺赔偿。"
    },
    {
      "title": "安全与合规要求",
      "content": "任何索要账号密码、验证码、支付密码的请求都必须拒绝并转人工；不得执行退款以外的资金操作。"
    }
