{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supportflow.local/schemas/approval-approved-v1.schema.json",
  "title": "approval.approved payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "approvalId", "approvalVersion", "executionVersion", "businessIdempotencyKey", "actionType", "orderNo", "amount", "currency", "eligibilityEvidence", "decidedByMembershipId"],
  "properties": {
    "schemaVersion": {"const": 1},
    "approvalId": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "approvalVersion": {"type": "integer", "minimum": 1},
    "executionVersion": {"type": "integer", "minimum": 1},
    "businessIdempotencyKey": {"type": "string", "minLength": 1, "maxLength": 128},
    "actionType": {"enum": ["refund.request", "compensation.issue"]},
    "orderNo": {"type": "string", "minLength": 1},
    "amount": {"type": "number", "exclusiveMinimum": 0},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "eligibilityEvidence": {"type": "string", "minLength": 1},
    "decidedByMembershipId": {"type": "string", "pattern": "^[1-9][0-9]*$"}
  }
}
