{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supportflow.local/schemas/refund-executed-v1.schema.json",
  "title": "refund.executed payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "approvalId", "approvalVersion", "executionVersion", "businessIdempotencyKey", "actionType", "orderNo", "amount", "currency"],
  "properties": {
    "schemaVersion": {"const": 1},
    "eventId": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "approvalId": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "approvalVersion": {"type": "integer", "minimum": 1},
    "executionVersion": {"type": "integer", "minimum": 1},
    "businessIdempotencyKey": {"type": "string", "minLength": 1, "maxLength": 128},
    "actionType": {"const": "refund.request"},
    "orderNo": {"type": "string", "minLength": 1},
    "amount": {"type": "number", "exclusiveMinimum": 0},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
  }
}
