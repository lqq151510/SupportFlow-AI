{
  "name": "supportflow-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --grep-invert @demo --workers=1",
    "test:e2e:macos": "PLAYWRIGHT_CHANNEL=chrome playwright test --grep-invert @demo",
    "test:demo": "playwright test --grep @demo --workers=1",
    "tauri": "tauri",
    "build:desktop-backend": "../script/build_desktop_backend.sh",
    "build:app": "npm run build:desktop-backend && tauri build",
    "build:dmg": "npm run build:desktop-backend && tauri build --bundles dmg"
  },
  "dependencies": {
    "@lucide/vue": "^1.46.0",
    "@tauri-apps/api": "^2.11.1",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.0.1",
    "typescript": "^5.8.3",
    "vite": "latest",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.11"
  }
}
